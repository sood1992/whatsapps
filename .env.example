# ===========================================
# TreatForTails WhatsApp Automation - Configuration
# ===========================================

# Application
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
APP_SECRET=your-super-secret-key-change-this

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/treatfortails_whatsapp

# Redis (for queues and caching)
REDIS_URL=redis://localhost:6379

# ===========================================
# WhatsApp Business API Configuration
# Get these from Meta Business Suite
# ===========================================
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_VERSION=v18.0

# ===========================================
# WooCommerce Configuration
# Get these from WooCommerce > Settings > Advanced > REST API
# ===========================================
WOOCOMMERCE_URL=https://treatfortails.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
WOOCOMMERCE_WEBHOOK_SECRET=your-webhook-secret

# ===========================================
# Business Settings
# ===========================================
BUSINESS_NAME=TreatForTails
BUSINESS_PHONE=+1234567890
BUSINESS_WEBSITE=https://treatfortails.com
BUSINESS_TIMEZONE=Asia/Kolkata

# ===========================================
# Message Settings
# ===========================================
# Time windows for sending messages (24-hour format)
MESSAGE_WINDOW_START=9
MESSAGE_WINDOW_END=21

# Abandoned cart settings
ABANDONED_CART_DELAY_MINUTES=60
ABANDONED_CART_FOLLOWUP_HOURS=24

# Rate limiting
MAX_MESSAGES_PER_MINUTE=80
MAX_MESSAGES_PER_DAY=1000

# ===========================================
# Admin Dashboard
# ===========================================
ADMIN_EMAIL=admin@treatfortails.com
ADMIN_PASSWORD=change-this-password

# JWT Settings
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d
